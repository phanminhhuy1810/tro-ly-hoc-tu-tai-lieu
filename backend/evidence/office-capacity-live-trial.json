      "mindmap": [
        {
          "title": "IPv4 Address Structure",
          "text": "IPv4 addresses are 32-bit identifiers. The prefix, like /26, defines the network portion, with the remaining bits for hosts.",
          "source_refs": [
            "00055136cfaa4d0ba7281e0ff0a9cadf:2:0",
            "00055136cfaa4d0ba7281e0ff0a9cadf:2:1",
